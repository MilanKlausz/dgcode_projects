#!/usr/bin/env python3

# The setups of the detector test (data/setups.toml): without arguments the list of setups; with setup names their
# simulation parameters, one per line (--line: on one line, for a command line)

import argparse
import shlex
import DetectorTest2026October.Setups as Setups

parser = argparse.ArgumentParser(prog='sb_detectortest2026october_params', description='The setups of the detector test.')
parser.add_argument('setups', nargs='*', metavar='SETUP')
parser.add_argument('--line', action='store_true', help='the parameters on one line')
args = parser.parse_args()
if not args.setups:
    for name, setup in Setups.load()['setups'].items():
        print(f"{name}: runs {', '.join(str(r) for r in setup.get('runs', []))}: {setup.get('description', '')}")
for name in args.setups:
    try:
        pars = [f'{key}={value}' for key, value in Setups.parameters(name).items()]
    except ValueError as error:
        parser.exit(1, f'ERROR: {error}\n')
    print(' '.join(shlex.quote(p) for p in pars) if args.line else '\n'.join(pars))
