#!/usr/bin/env python3

# sb_lokiambe_sim with the parameters of a setup of the detector test (data/setups.toml): setup=<name>; parameters given
# on the command line replace those of the setup, e.g.
#   sb_detectortest2026october_sim setup=C -n1000 max_energy_eV=1e5

import sys
import DetectorTest2026October.Setups as Setups

name, args = Setups.expand(sys.argv[1:])
if name is None and not any(a in ('-h', '--help') for a in args):
    print('NOTE: no setup=<name> given (setups: ' + ', '.join(Setups.names()) + '): sb_lokiambe_sim without a setup', flush=True)
sys.argv[1:] = args
user_data = None
if name is not None:
    user_data = {'detector_test_setup': name, 'detector_test_setups_checksum': Setups.checksum()}
    print(f'DetectorTest2026October: setup {name} (setups.toml {Setups.checksum()})', flush=True)

import LokiAmBe.Launcher
LokiAmBe.Launcher.launch(user_data)
